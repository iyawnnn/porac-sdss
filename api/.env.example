# NestJS API (api/). Copy to .env and fill in. Validated at boot by
# src/config/env.ts — a missing/malformed required var fails startup, not
# the first request.

# Neon's DIRECT/unpooled endpoint, not the -pooler one root's .env.local
# uses. This is a long-lived process with its own connection pool
# (db/db.module.ts, max: 10) — double-pooling through pgbouncer transaction
# mode breaks pg_advisory_xact_lock and prepared statements, which the
# reports-merge transaction depends on. See PLAN blueprint §2.
DATABASE_URL=

# Must be the identical value as root's JWT_SECRET (.env.local) — both
# sides sign/verify the same two session cookies.
JWT_SECRET=

CLOUDINARY_URL=
OPENWEATHERMAP_API_KEY=

# Bearer/x-cron-secret value CronSecretGuard checks (POST
# /cron/recompute-urgency, /cron/recompute-weather).
CRON_SECRET=

PORT=3001
NODE_ENV=development

# Only needed once a non-Next client calls the API directly and
# enableCors() actually gets turned on (CORS is skipped entirely today —
# the Next rewrite makes every browser request same-origin). See PLAN
# blueprint §4.
# WEB_ORIGIN=

# Municipality config — all have Angeles/Porac defaults, only set to
# target a different LGU. Must match root's TARGET_* values.
TARGET_MUNICIPALITY_NAME="Municipality of Porac"
TARGET_MUNICIPALITY_PSGC_CODE=030541500
TARGET_BARANGAY_COUNT=29
TARGET_MIN_LAT=14.98
TARGET_MAX_LAT=15.16
TARGET_MIN_LNG=120.35
TARGET_MAX_LNG=120.62
