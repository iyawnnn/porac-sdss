# NestJS API (api/). Copy to .env and fill in. Validated at boot by
# src/config/env.ts — a missing/malformed required var fails startup, not
# the first request.

# Neon's DIRECT/unpooled endpoint, not the -pooler one root's .env.local
# uses. This is a long-lived process with its own connection pool
# (db/db.module.ts, max: 10) — double-pooling through pgbouncer transaction
# mode breaks pg_advisory_xact_lock and prepared statements, which the
# reports-merge transaction depends on. See PLAN blueprint §2.
DATABASE_URL=

# Must be the identical value as root's JWT_SECRET (.env.local) — both
# sides sign/verify the same two session cookies.
JWT_SECRET=

CLOUDINARY_URL=
OPENWEATHERMAP_API_KEY=

# Bearer/x-cron-secret value CronSecretGuard checks (POST
# /cron/recompute-urgency, /cron/recompute-weather).
CRON_SECRET=

PORT=3001
NODE_ENV=development

# Only needed once a non-Next client calls the API directly and
# enableCors() actually gets turned on (CORS is skipped entirely today —
# the Next rewrite makes every browser request same-origin). See PLAN
# blueprint §4. Also used as the OAuth post-login/error redirect target
# (see api/src/auth/oauth.controller.ts) — required for Google login to
# work.
WEB_ORIGIN=http://localhost:3000

# Google OAuth (api/src/auth/oauth.*), the only social login provider. The
# redirect URI must be registered exactly as-is in the Google console and
# point through the Next rewrite (WEB_ORIGIN + /api/auth/google/callback)
# so the resulting session cookie lands same-origin with the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Signs the short-lived OAuth CSRF-state token (oauth-state.service.ts).
# Deliberately separate from JWT_SECRET so state tokens can't be replayed
# as session tokens or vice versa.
OAUTH_STATE_SECRET=

# Forgot Password (citizens/password-reset.*). Reset tokens are single-use
# and expire after this many minutes.
RESET_TOKEN_TTL_MINUTES=30
# From-address for reset/notification emails, e.g. onboarding@resend.dev
# for local testing against a real Resend account.
# EMAIL_FROM=no-reply@example.com
# Selects the EmailService implementation (citizens/citizens.module.ts):
# set -> ResendEmailService (real delivery via the Resend API). Unset ->
# ConsoleEmailService (dev/test fallback, logs a masked confirmation only,
# never sends). Never required for local dev/tests to pass.
# RESEND_API_KEY=

# Municipality config — all have Angeles/Porac defaults, only set to
# target a different LGU. Must match root's TARGET_* values.
TARGET_MUNICIPALITY_NAME="Municipality of Porac"
TARGET_MUNICIPALITY_PSGC_CODE=030541500
TARGET_BARANGAY_COUNT=29
TARGET_MIN_LAT=14.98
TARGET_MAX_LAT=15.16
TARGET_MIN_LNG=120.35
TARGET_MAX_LNG=120.62
