{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/clean-build-cache.js && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node scripts/clean-build-cache.js && nest start",
    "start:dev": "node scripts/clean-build-cache.js && nest start --watch",
    "start:debug": "node scripts/clean-build-cache.js && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate": "tsx --env-file=.env scripts/migrations/migrate.ts",
    "migrate:geometry": "tsx --env-file=.env scripts/migrations/migrate-geometry.ts",
    "migrate:ratelimit": "tsx --env-file=.env scripts/migrations/migrate-ratelimit.ts",
    "migrate:ratelimit-citizen": "tsx --env-file=.env scripts/migrations/migrate-ratelimit-citizen.ts",
    "migrate:citizen-identities": "tsx --env-file=.env scripts/migrations/migrate-citizen-identities.ts",
    "migrate:citizen-account-security": "tsx --env-file=.env scripts/migrations/migrate-citizen-account-security.ts",
    "migrate:citizen-password-reset": "tsx --env-file=.env scripts/migrations/migrate-citizen-password-reset.ts",
    "migrate:notifications": "tsx --env-file=.env scripts/migrations/migrate-notifications.ts",
    "migrate:admin-system-role": "tsx --env-file=.env scripts/migrations/migrate-admin-system-role.ts",
    "migrate:admin-created-at": "tsx --env-file=.env scripts/migrations/migrate-admin-created-at.ts",
    "migrate:admin-audit-events": "tsx --env-file=.env scripts/migrations/migrate-admin-audit-events.ts",
    "migrate:admin-password-security": "tsx --env-file=.env scripts/migrations/migrate-admin-password-security.ts",
    "migrate:admin-status": "tsx --env-file=.env scripts/migrations/migrate-admin-status.ts",
    "migrate:work-orders": "tsx --env-file=.env scripts/migrations/migrate-work-orders.ts",
    "migrate:city-boundary": "tsx --env-file=.env scripts/migrations/migrate-city-boundary.ts",
    "migrate:config": "tsx --env-file=.env scripts/migrations/migrate-config.ts",
    "migrate:exif-data": "tsx --env-file=.env scripts/migrations/migrate-exif-data.ts",
    "migrate:diverse-demo": "tsx --env-file=.env scripts/migrations/migrate-diverse-demo.ts",
    "migrate:moderation": "tsx --env-file=.env scripts/migrations/migrate-moderation.ts",
    "migrate:resolution": "tsx --env-file=.env scripts/migrations/migrate-resolution.ts",
    "import:barangays": "tsx --env-file=.env scripts/seed/import-barangays.ts",
    "import:city-boundary": "tsx --env-file=.env scripts/seed/import-city-boundary.ts",
    "seed:dem": "tsx --env-file=.env scripts/seed/seed-dem.ts",
    "seed:admin": "tsx --env-file=.env scripts/seed/seed-admin.ts",
    "seed:e2e-admins": "tsx --env-file=.env scripts/seed/seed-e2e-admins.ts",
    "seed:users": "tsx --env-file=.env scripts/seed/seed-users.ts",
    "seed:mock-report": "tsx --env-file=.env scripts/seed/seed-mock-report.ts",
    "seed:bulk-reports": "tsx --env-file=.env scripts/seed/seed-bulk-reports.ts",
    "seed:diverse-reports": "tsx --env-file=.env scripts/seed/seed-diverse-reports.ts",
    "verify:config": "tsx --env-file=.env scripts/verify/verify-config.ts",
    "verify:city-boundary": "tsx --env-file=.env scripts/verify/verify-city-boundary.ts",
    "verify:dedup-exif": "tsx --env-file=.env scripts/verify/verify-dedup-exif.ts",
    "verify:diverse-reports": "tsx --env-file=.env scripts/verify/verify-diverse-reports.ts",
    "verify:seed-images": "tsx --env-file=.env scripts/verify/verify-seed-images.ts",
    "verify:build-recovery": "node scripts/verify/verify-build-recovery.js",
    "db:migrate": "pnpm run migrate",
    "db:seed": "tsx --env-file=.env scripts/seed/seed-diverse-reports.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "geotiff": "^3.0.5",
    "jose": "^6.2.5",
    "piexifjs": "^1.0.6",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/jose@[^/]+/node_modules/)?jose/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
