# Next.js app (root). Copy to .env.local and fill in.
#
# As of Phase 9 of the NestJS extraction (see PLAN blueprint), this app is
# UI-only — it proxies /api/* to the standalone service in api/ and no
# longer runs a database-backed API of its own. DATABASE_URL/CLOUDINARY_URL/
# OPENWEATHERMAP_API_KEY below are only read by the one-time setup scripts
# in scripts/ (migrate, seed, import), not by the running Next app.

# --- Talks to the NestJS API ---
# Server-to-server origin next.config.ts rewrites /api/* to, and
# lib/api-client.ts's Server Components fetch from directly.
API_ORIGIN=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001

# --- Shared with api/ (must be the identical value on both sides) ---
# Signs/verifies the two session cookies. proxy.ts still verifies these
# locally for the page-redirect UX even though NestJS owns real API auth.
JWT_SECRET=

# --- Only used by scripts/ (migrate, seed, import — see CLAUDE.md) ---
DATABASE_URL=
CLOUDINARY_URL=
OPENWEATHERMAP_API_KEY=

# --- Municipality config (lib/municipality-config.ts) ---
# All have Angeles/Porac defaults baked in — only set these when targeting
# a different LGU. NEXT_PUBLIC_* ones are read client-side by map components.
NEXT_PUBLIC_TARGET_CITY_CENTER_LAT=15.0711
NEXT_PUBLIC_TARGET_CITY_CENTER_LNG=120.5401
NEXT_PUBLIC_TARGET_MAP_ZOOM=12
TARGET_MUNICIPALITY_NAME="Municipality of Porac"
TARGET_MUNICIPALITY_PSGC_CODE=030541500
TARGET_BARANGAY_COUNT=29
TARGET_MIN_LAT=14.98
TARGET_MAX_LAT=15.16
TARGET_MIN_LNG=120.35
TARGET_MAX_LNG=120.62
